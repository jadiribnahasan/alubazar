---
const { title } = Astro.props as { title?: string };
import '@fontsource/noto-sans-bengali/400.css';
import '@fontsource/noto-sans-bengali/700.css';
import { themeBootstrap } from '../lib/theme';
import '../styles/global.css';
---
<html lang="bn" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0f766e" />
    <meta name="description" content="অফলাইনে কাজ করুন, অনলাইনে এলে স্বয়ংক্রিয়ভাবে সিঙ্ক হবে।" />
    <title>{title ?? 'হিসাব খাতা'}</title>
    <link rel="icon" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="হিসাব খাতা" />
    <!-- Must run before first paint, or the shop sees a white flash on every
         launch. Deliberately inline and un-deferred. -->
    <script is:inline set:html={themeBootstrap()} />
  </head>
  <body>
    <slot />
  </body>
</html>