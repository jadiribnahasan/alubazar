<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Styles for the Bangla invoice sheet.

         Layout is built entirely from tables: WeasyPrint has no CSS grid and
         unreliable flex `gap`, so table-cell is the only construct that lays out
         identically everywhere. Colours are plain background-color for the same
         reason. The running footer is a @page margin box, not a fixed element. -->
    <template id="invoice_report_style">
        <style type="text/css">
            :root {}
            .bn-invoice {
                font-family: 'Noto Sans Bengali', 'Lohit Bengali', 'Noto Sans', sans-serif;
                color: #0f172a;
                font-size: 10.5px;
                line-height: 1.45;
            }
            .bn-invoice table { width: 100%; border-collapse: collapse; }
            .bn-r { text-align: right; }
            .bn-c { text-align: center; }

            /* accent */
            .bn-accent { background: #0f766e; color: #ffffff; }

            /* ---------- header band ---------- */
            .bn-band { width: 100%; border-collapse: collapse; }
            .bn-band-main { width: 66%; padding: 0; vertical-align: top; }
            .bn-band-side {
                width: 34%;
                padding: 0;
                vertical-align: top;
                text-align: right;
                white-space: nowrap;
            }
            .bn-band-inner { padding: 9px 12px; }
            .bn-logo {
                max-height: 40px;
                max-width: 140px;
                margin: 0 0 5px;
                border: 0;
            }
            .bn-company-name {
                font-size: 18px;
                font-weight: 700;
                line-height: 1.15;
                /* named so the @page footer can repeat it */
                string-set: bn-company content();
            }
            .bn-tagline { font-size: 10.5px; color: #ccfbf1; margin-top: 2px; }
            .bn-contact { font-size: 9.5px; color: #e6fffb; margin-top: 5px; line-height: 1.4; }
            .bn-doc-title {
                font-size: 15px;
                font-weight: 700;
                letter-spacing: .5px;
                margin-bottom: 4px;
                text-transform: uppercase;
            }
            .bn-doc-meta { font-size: 9.5px; color: #e6fffb; line-height: 1.5; }
            .bn-doc-meta b { color: #ffffff; }

            /* ---------- party cards ---------- */
            .bn-parties { margin-top: 14px; }
            .bn-party {
                width: 50%;
                padding: 0;
                vertical-align: top;
            }
            .bn-party-gap { width: 12px; }
            .bn-party-box {
                padding: 10px 12px;
                background: #f8fafc;
                border: 1px solid #e2e8f0;
                border-top: 3px solid #0f766e;
            }
            .bn-party-label {
                font-size: 8.5px;
                font-weight: 700;
                letter-spacing: .8px;
                text-transform: uppercase;
                color: #0f766e;
                margin-bottom: 4px;
            }
            .bn-party-name { font-size: 12.5px; font-weight: 700; line-height: 1.3; }
            .bn-party-line { font-size: 10px; color: #475569; line-height: 1.55; }

            /* ---------- lines ---------- */
            .bn-lines { margin-top: 14px; }
            .bn-lines th {
                background: #0f766e;
                color: #ffffff;
                font-size: 9.5px;
                font-weight: 700;
                letter-spacing: .3px;
                padding: 8px 7px;
                border: 0;
            }
            .bn-lines th.bn-serial { width: 28px; }
            .bn-lines th.bn-qty { width: 64px; }
            .bn-lines th.bn-money { width: 82px; }
            .bn-lines td {
                padding: 7px;
                font-size: 10.5px;
                vertical-align: top;
                border-bottom: 1px solid #e2e8f0;
            }
            /* striping comes from QWeb, not nth-child, so it cannot depend on
               selector support */
            .bn-lines tr.bn-stripe td { background: #f8fafc; }
            .bn-lines .bn-serial { color: #94a3b8; font-weight: 700; }
            .bn-lines .bn-code { font-size: 9px; color: #64748b; }
            .bn-lines .bn-money { font-weight: 600; }
            .bn-lines tr.bn-section td {
                background: #f1f5f9;
                font-weight: 700;
                color: #0f172a;
            }
            .bn-lines tr.bn-note td {
                background: #f8fafc;
                font-style: italic;
                color: #475569;
            }

            /* ---------- totals ---------- */
            .bn-totals-wrap { margin-top: 14px; }
            .bn-totals-pad { width: 52%; }
            .bn-totals {
                border: 1px solid #e2e8f0;
                border-collapse: collapse;
            }
            .bn-totals td { padding: 6px 9px; font-size: 10.5px; }
            .bn-totals tr.bn-grand td {
                background: #0f766e;
                color: #ffffff;
                font-size: 14px;
                font-weight: 700;
                padding: 9px;
            }
            .bn-totals tr.bn-words td {
                background: #f8fafc;
                font-size: 9.5px;
                color: #475569;
            }
            .bn-state { font-weight: 700; }
            .bn-state-paid { color: #047857; }
            .bn-state-due { color: #b91c1c; }
            .bn-state-part { color: #b45309; }

            /* ---------- notes, terms, signature ---------- */
            .bn-block {
                margin-top: 14px;
                padding: 9px 11px;
                background: #f8fafc;
                border: 1px solid #e2e8f0;
                border-left: 3px solid #0f766e;
                font-size: 10px;
                color: #334155;
                line-height: 1.6;
            }
            .bn-block-title {
                font-size: 8.5px;
                font-weight: 700;
                letter-spacing: .8px;
                text-transform: uppercase;
                color: #0f766e;
                margin-bottom: 4px;
            }
            .bn-sign { margin-top: 26px; width: 100%; border-collapse: collapse; }
            .bn-sign-box { width: 50%; text-align: center; font-size: 10px; color: #334155; }
            .bn-sign-rule {
                margin: 0 16px 6px;
                border-bottom: 1px solid #94a3b8;
                height: 30px;
            }

            /* ---------- running footer ---------- */
            @page {
                @bottom-center {
                    content: string(bn-company) "  ·  পৃষ্ঠা " counter(page) " / " counter(pages);
                    font-family: 'Noto Sans Bengali', 'Lohit Bengali', 'Noto Sans', sans-serif;
                    font-size: 8.5px;
                    color: #94a3b8;
                    padding-top: 4px;
                    border-top: 1px solid #e2e8f0;
                    width: 100%;
                }
            }
        </style>
    </template>

    <!-- Invoice / receipt / credit note sheet built from the company profile.

         This is a *document* template, not a standalone report:
         account.report_invoice already wraps every document in
         web.html_container, so this must not do it again. -->
    <template id="report_invoice_document">
        <t t-call="bn_root_invoicing.invoice_report_style"/>

        <t t-set="company" t-value="o.company_id.sudo()"/>
        <t t-set="currency" t-value="o.currency_id"/>

        <div class="bn-invoice">

            <!-- ========== header band ========== -->
            <table class="bn-band">
                <tr>
                    <td class="bn-band-main bn-accent">
                        <div class="bn-band-inner">
                            <img t-if="company.bn_invoice_show_logo and company.logo"
                                 class="bn-logo"
                                 t-att-src="image_data_uri(company.logo)"
                                 alt="Logo"/>
                            <div class="bn-company-name" t-out="company.name"/>
                            <div t-if="company.bn_invoice_tagline" class="bn-tagline" t-out="company.bn_invoice_tagline"/>
                            <div class="bn-contact">
                                <t t-foreach="company.bn_invoice_contact_lines()" t-as="contact">
                                    <div><span t-out="contact[0]"/>: <span t-out="contact[1]"/></div>
                                </t>
                                <t t-foreach="company.bn_invoice_address_lines()" t-as="addr">
                                    <div t-out="addr"/>
                                </t>
                                <div t-if="company.vat">ট্যাক্স আইডি: <span t-field="company.vat"/></div>
                                <div t-if="company.bn_invoice_registry">রেজিস্ট্রেশন: <span t-field="company.bn_invoice_registry"/></div>
                            </div>
                        </div>
                    </td>
                    <td class="bn-band-side bn-accent">
                        <div class="bn-band-inner">
                            <div t-if="o.move_type == 'out_invoice' and o.state == 'posted'" class="bn-doc-title">ইনভয়েস</div>
                            <div t-elif="o.move_type == 'out_invoice'" class="bn-doc-title">খসড়া ইনভয়েস</div>
                            <div t-elif="o.move_type == 'out_refund' and o.state == 'posted'" class="bn-doc-title">ক্রেডিট নোট</div>
                            <div t-elif="o.move_type == 'out_refund'" class="bn-doc-title">খসড়া ক্রেডিট নোট</div>
                            <div t-else="" class="bn-doc-title">বিল</div>
                            <div class="bn-doc-meta">
                                <div>নং: <b t-out="o.name or '-'"/></div>
                                <div>তারিখ: <b t-out="o.invoice_date or o.date"/></div>
                                <div t-if="o.invoice_date_due and o.move_type in ('out_invoice', 'out_refund') and o.state == 'posted'">
                                    পরিশোধযোগ্য: <b t-out="o.invoice_date_due"/>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- ========== seller / customer ========== -->
            <table class="bn-parties">
                <tr>
                    <td class="bn-party">
                        <div class="bn-party-box">
                            <div class="bn-party-label">বিক্রেতা</div>
                            <div class="bn-party-name" t-out="company.name"/>
                            <t t-foreach="company.bn_invoice_address_lines()" t-as="addr">
                                <div class="bn-party-line" t-out="addr"/>
                            </t>
                            <t t-foreach="company.bn_invoice_contact_lines()" t-as="contact">
                                <div class="bn-party-line"><span t-out="contact[0]"/>: <span t-out="contact[1]"/></div>
                            </t>
                        </div>
                    </td>
                    <td class="bn-party-gap"/>
                    <td class="bn-party">
                        <div class="bn-party-box">
                            <div class="bn-party-label">গ্রাহক</div>
                            <div class="bn-party-name" t-out="o.partner_id.name"/>
                            <t t-foreach="o.partner_id.bn_invoice_address_lines()" t-as="addr">
                                <div class="bn-party-line" t-out="addr"/>
                            </t>
                            <t t-foreach="o.partner_id.bn_invoice_contact_lines()" t-as="contact">
                                <div class="bn-party-line"><span t-out="contact[0]"/>: <span t-out="contact[1]"/></div>
                            </t>
                            <div t-if="o.partner_id.vat" class="bn-party-line">ট্যাক্স আইডি: <span t-field="o.partner_id.vat"/></div>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- ========== lines ========== -->
            <table class="bn-lines">
                <thead>
                    <tr>
                        <th class="bn-serial bn-c">ক্রম</th>
                        <th>বিবরণ</th>
                        <th class="bn-qty bn-r">পরিমাণ</th>
                        <th class="bn-money bn-r">একক মূল্য</th>
                        <th class="bn-money bn-r">মোট</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.invoice_line_ids.filtered(lambda l: l.display_type == 'product').sorted(lambda l: l.sequence)" t-as="line">
                        <tr t-att-class="'bn-stripe' if line_index % 2 else ''">
                            <td class="bn-serial bn-c">
                                <span t-out="line_index + 1">1</span>
                            </td>
                            <td>
                                <div t-out="line.name"/>
                                <div t-if="line.product_id.default_code" class="bn-code">কোড: <span t-out="line.product_id.default_code"/></div>
                            </td>
                            <td class="bn-qty bn-r">
                                <span t-out="line.quantity" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}">1</span>
                                <div t-if="line.product_uom_id and line.product_uom_id != line.product_id.uom_id" class="bn-code" t-out="line.product_uom_id.name"/>
                            </td>
                            <td class="bn-money bn-r">
                                <span t-out="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td class="bn-money bn-r">
                                <span t-if="o.document_tax_mode == 'tax_excluded'"
                                      t-out="line.price_subtotal"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                <span t-if="o.document_tax_mode == 'tax_included'"
                                      t-out="line.price_total"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                        </tr>
                    </t>
                    <t t-foreach="o.invoice_line_ids.filtered(lambda l: l.display_type in ('line_section', 'line_note'))" t-as="line">
                        <tr t-att-class="'bn-section' if line.display_type == 'line_section' else 'bn-note'">
                            <td colspan="5" t-out="line.name"/>
                        </tr>
                    </t>
                    <tr t-if="not o.invoice_line_ids">
                        <td colspan="5" class="bn-c">কোনো আইটেম নেই</td>
                    </tr>
                </tbody>
            </table>

            <!-- ========== totals ========== -->
            <table class="bn-totals-wrap">
                <tr>
                    <td class="bn-totals-pad"/>
                    <td>
                        <table class="bn-totals">
                            <tr>
                                <td>মোট</td>
                                <td class="bn-r">
                                    <span t-out="o.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                            <tr t-if="o.amount_tax">
                                <td>ভ্যাট / কর</td>
                                <td class="bn-r">
                                    <span t-out="o.amount_tax" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                            <tr t-if="o.amount_total_words" class="bn-words">
                                <td colspan="2" t-out="o.amount_total_words"/>
                            </tr>
                            <tr class="bn-grand">
                                <td>সর্বমোট</td>
                                <td class="bn-r">
                                    <span t-out="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                            <tr t-if="o.move_type in ('out_invoice', 'out_refund') and o.state == 'posted'">
                                <td>পরিশোধের অবস্থা</td>
                                <td class="bn-r">
                                    <span t-if="o.payment_state in ('paid', 'invoicing_legacy')" class="bn-state bn-state-paid">পরিশোধিত</span>
                                    <span t-elif="o.payment_state == 'partial'" class="bn-state bn-state-part">আংশিক পরিশোধিত</span>
                                    <span t-elif="o.payment_state == 'not_paid'" class="bn-state bn-state-due">বাকি</span>
                                    <span t-else="" class="bn-state">—</span>
                                </td>
                            </tr>
                            <tr t-if="o.move_type in ('out_invoice', 'out_refund') and o.state == 'posted' and o.amount_residual and o.payment_state != 'paid'">
                                <td>দেনা রয়েছে</td>
                                <td class="bn-r">
                                    <span t-field="o.amount_residual"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- ========== terms and notes ========== -->
            <div t-if="company.bn_invoice_show_terms and (not is_html_empty(company.bn_invoice_terms) or not is_html_empty(o.narration))" class="bn-block">
                <div t-if="not is_html_empty(company.bn_invoice_terms)">
                    <div class="bn-block-title">শর্তাবলী</div>
                    <span t-field="company.bn_invoice_terms"/>
                </div>
                <div t-if="not is_html_empty(o.narration)" style="margin-top: 6px">
                    <div class="bn-block-title">বিবরণ</div>
                    <span t-field="o.narration"/>
                </div>
            </div>

            <div t-if="company.bn_invoice_note" class="bn-block">
                <span t-field="company.bn_invoice_note"/>
            </div>

            <!-- ========== signature ========== -->
            <table t-if="company.bn_invoice_show_signature" class="bn-sign">
                <tr>
                    <td class="bn-sign-box">
                        <div class="bn-sign-rule"/>
                        <span t-out="company.bn_invoice_seller_label or 'বিক্রেতার স্বাক্ষর'"/>
                    </td>
                    <td class="bn-sign-box">
                        <div class="bn-sign-rule"/>
                        <span t-out="company.bn_invoice_buyer_label or 'ক্রেতার স্বাক্ষর'"/>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <!-- Our own entry point for customer invoices, rendered by WeasyPrint.

         Kept separate from account.report_invoice on purpose: WeasyPrint draws
         Bengali conjuncts correctly and wkhtmltopdf does not, but Odoo's stock
         layouts rely on Bootstrap flexbox that WeasyPrint does not implement.
         Only this self-contained sheet moves; vendor bills keep wkhtmltopdf. -->
    <template id="report_invoice_wrapper">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-if="o.move_type in ('out_invoice', 'out_refund')">
                    <t t-call="bn_root_invoicing.report_invoice_document" t-lang="o.partner_id.lang"/>
                </t>
                <t t-else="" t-call="account.report_invoice_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <record id="report_invoice_action" model="ir.actions.report">
        <field name="name">Bangla Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bn_root_invoicing.report_invoice_wrapper</field>
        <field name="print_report_name">'Invoice - %s' % (object.name)</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>